# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Experiment output: raw run data is large and machine-generated.
# Keep the directory itself (results/runs/.gitkeep) but not the runs.
results/runs/*
!results/runs/.gitkeep

# Derived analysis output is regenerated by analysis/aggregate.py
analysis/out/*
!analysis/out/.gitkeep

# ...with an exception for the finished research deliverables. They are
# regenerable in principle, but only from results/runs/, which is deliberately
# not in git (large, machine-generated). Without these a clone would contain
# the code that produces the findings but not the findings themselves.
!analysis/out/REPORT.md
!analysis/out/results.md
!analysis/out/*.png
!analysis/out/summary_*.csv
!analysis/out/per_run_metrics.csv
!analysis/out/behaviour_verification.json
!analysis/out/diagnostics.json
!analysis/out/aggregate_provenance.json

# Learned Q-tables are run artefacts, not source
*.qtable.json

# Mininet / OVS leftovers
*.log
*.pcap

# Editor
.vscode/
.idea/
*.swp

# Smoke-test scratch output (regenerate with experiments/smoke.py)
results/smoke/

# Dashboard
dashboard/frontend/node_modules/
dashboard/frontend/dist/
dashboard/frontend/.vite/
results/dashboard_logs/
results/dashboard_api.log
