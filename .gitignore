# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Experiment output: raw run data is large and machine-generated.
# Keep the directory itself (results/runs/.gitkeep) but not the runs.
results/runs/*
!results/runs/.gitkeep

# Derived analysis output is regenerated by analysis/aggregate.py
analysis/out/*
!analysis/out/.gitkeep

# Learned Q-tables are run artefacts, not source
*.qtable.json

# Mininet / OVS leftovers
*.log
*.pcap

# Editor
.vscode/
.idea/
*.swp

# Smoke-test scratch output (regenerate with experiments/smoke.py)
results/smoke/
